# Copy this file to .env, then fill values locally. Do not share .env.
DASHSCOPE_API_KEY=
ALIYUN_ASR_MODEL=paraformer-v2
ALIYUN_SPEAKER_DIARIZATION=true
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
# Optional workspace API URL from the Model Studio console:
# DASHSCOPE_BASE_URL=https://YOUR-WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1
WX_ROLE_CORRECTION=0
